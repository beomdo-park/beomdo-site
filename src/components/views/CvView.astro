---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PROFILE } from '../../data/profile';
import { SITE } from '../../data/site';
import { PUB_STATS } from '../../data/publications';
import { getLocalePath, type Locale } from '../../data/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isKo = locale === 'ko';
---

<BaseLayout
  locale={locale}
  title={isKo ? '이력 (CV)' : 'Curriculum Vitae'}
  description={isKo ? '박범도의 학력, 연구·개발 경력, 수상·자격 및 기술 스택.' : 'Education, research experience, honors, certifications, and technical stack of Beomdo Park.'}
>
  <div class="space-y-11">
    <header class="pb-7 border-b border-[var(--border-hairline)] space-y-3">
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-[var(--text-primary)]">
          {isKo ? '이력 (CV)' : 'Curriculum Vitae'}
        </h1>
        <div class="flex flex-wrap gap-3 text-xs font-mono">
          <a href={`mailto:${SITE.email}`} class="text-[var(--accent-primary)] hover:underline">{SITE.email}</a>
          <a href={SITE.links.github} target="_blank" rel="noreferrer" class="text-[var(--text-secondary)] hover:text-[var(--text-primary)]">GitHub</a>
          <a href={SITE.links.dbpia} target="_blank" rel="noreferrer" class="text-[var(--text-secondary)] hover:text-[var(--text-primary)]">DBpia</a>
          <a href={SITE.links.scholar} target="_blank" rel="noreferrer" class="text-[var(--text-secondary)] hover:text-[var(--text-primary)]">Scholar</a>
        </div>
      </div>
      <p class="text-sm sm:text-base text-[var(--text-secondary)] leading-relaxed max-w-[68ch]">
        {PROFILE.bio[locale]}
      </p>
    </header>

    <!-- Education -->
    <section class="space-y-3">
      <h2 class="text-base font-semibold text-[var(--text-primary)] border-b border-[var(--border-hairline)] pb-2">
        {isKo ? '학력' : 'Education'}
      </h2>
      {PROFILE.education.map((edu) => (
        <div class="grid grid-cols-1 sm:grid-cols-12 gap-1 sm:gap-4 py-2">
          <div class="sm:col-span-3 font-mono text-xs text-[var(--text-tertiary)]">
            {isKo ? edu.period : edu.periodEn}
          </div>
          <div class="sm:col-span-9 space-y-0.5">
            <div class="text-sm font-semibold text-[var(--text-primary)]">{isKo ? edu.degreeKo : edu.degreeEn}</div>
            <div class="text-xs text-[var(--text-secondary)]">{isKo ? edu.detailKo : edu.detailEn}</div>
          </div>
        </div>
      ))}
    </section>

    <!-- Experience -->
    <section class="space-y-3">
      <h2 class="text-base font-semibold text-[var(--text-primary)] border-b border-[var(--border-hairline)] pb-2">
        {isKo ? '연구 및 개발 경력' : 'Research & Engineering Experience'}
      </h2>
      <ul class="divide-y divide-[var(--border-hairline)]">
        {PROFILE.experiences.map((exp) => (
          <li class="py-3.5 grid grid-cols-1 sm:grid-cols-12 gap-1.5 sm:gap-4">
            <div class="sm:col-span-3 font-mono text-xs text-[var(--text-tertiary)]">{exp.period}</div>
            <div class="sm:col-span-9 space-y-1">
              <div class="text-sm font-semibold text-[var(--text-primary)]">{isKo ? exp.roleKo : exp.roleEn}</div>
              <div class="text-xs text-[var(--accent-primary)]">
                {exp.url ? (
                  <a href={exp.url} target="_blank" rel="noreferrer" class="hover:underline">
                    {isKo ? exp.orgKo : exp.orgEn}
                  </a>
                ) : (
                  isKo ? exp.orgKo : exp.orgEn
                )}
              </div>
              <p class="text-sm text-[var(--text-secondary)] leading-relaxed">{isKo ? exp.detailKo : exp.detailEn}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <!-- Publications summary pointer -->
    <section class="rounded-lg border border-[var(--border-hairline)] bg-[var(--bg-subtle)]/55 p-4 flex flex-wrap items-center justify-between gap-3 text-sm">
      <div>
        <span class="font-semibold text-[var(--text-primary)]">
          {isKo
            ? `논문 ${PUB_STATS.totalPapers}편 (1저자 ${PUB_STATS.firstAuthor} · SCIE ${PUB_STATS.scie}) 및 등록특허 ${PUB_STATS.grantedPatents}건`
            : `${PUB_STATS.totalPapers} Publications (${PUB_STATS.firstAuthor} 1st-author, ${PUB_STATS.scie} SCIE) & ${PUB_STATS.grantedPatents} Granted Patent`}
        </span>
      </div>
      <a href={getLocalePath(locale, '/publications')} class="text-xs font-medium text-[var(--accent-primary)] hover:underline">
        {isKo ? '전체 논문 목록 및 DBpia 링크 →' : 'Full publication list & BibTeX →'}
      </a>
    </section>

    <!-- Awards & Certifications -->
    <section class="space-y-3">
      <h2 class="text-base font-semibold text-[var(--text-primary)] border-b border-[var(--border-hairline)] pb-2">
        {isKo ? '수상 · 대회 · 자격' : 'Honors, Competitions & Certifications'}
      </h2>
      <ul class="divide-y divide-[var(--border-hairline)]">
        {PROFILE.awards.map((aw) => (
          <li class="py-2.5 grid grid-cols-1 sm:grid-cols-12 gap-1 sm:gap-4 items-baseline">
            <span class="sm:col-span-2 font-mono text-xs tabular-nums text-[var(--text-tertiary)]">{aw.date}</span>
            <div class="sm:col-span-10">
              <span class="text-sm font-medium text-[var(--text-primary)]">{isKo ? aw.titleKo : aw.titleEn}</span>
              <span class="ml-2 text-xs text-[var(--text-tertiary)]">{isKo ? aw.orgKo : aw.orgEn}</span>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <!-- Tech Stack -->
    <section class="space-y-3">
      <h2 class="text-base font-semibold text-[var(--text-primary)] border-b border-[var(--border-hairline)] pb-2">
        {isKo ? '기술 스택' : 'Technical Stack'}
      </h2>
      <dl class="space-y-2.5 text-sm">
        {PROFILE.techStack.map((cat) => (
          <div class="grid grid-cols-1 sm:grid-cols-12 gap-1 sm:gap-4">
            <dt class="sm:col-span-3 text-xs font-semibold text-[var(--text-tertiary)] pt-0.5">
              {isKo ? cat.groupKo : cat.groupEn}
            </dt>
            <dd class="sm:col-span-9 font-mono text-xs text-[var(--text-primary)] leading-relaxed">
              {cat.items.join(' · ')}
            </dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- Contact CTA -->
    <section class="pt-4 border-t border-[var(--border-hairline)] flex flex-wrap items-center justify-between gap-3 text-sm">
      <p class="text-[var(--text-secondary)]">
        {isKo ? '연구 협업이나 대학원·채용 관련 문의는 이메일로 편하게 연락 주세요.' : 'For research collaborations or inquiries, feel free to reach out via email.'}
      </p>
      <a
        href={`mailto:${SITE.email}`}
        class="rounded-md border border-[var(--border-strong)] px-3 py-1.5 font-mono text-xs font-medium text-[var(--text-primary)] hover:bg-[var(--bg-subtle)]"
      >
        {SITE.email}
      </a>
    </section>
  </div>
</BaseLayout>
