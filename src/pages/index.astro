---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroTelemetry from '../components/react/HeroTelemetry';
import { SITE } from '../data/site';
import { PUBLICATIONS, PUB_STATS } from '../data/publications';
import { RESEARCH_TRACKS } from '../data/research';
import { PROJECTS } from '../data/projects';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const recentPosts = allPosts.slice(0, 4);
const featuredPubs = PUBLICATIONS.filter((p) => p.featured).slice(0, 5);
const featuredProjects = PROJECTS.filter((p) => p.featured);
---

<BaseLayout>
  <!-- Asymmetric Workbench Hero -->
  <section class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start pb-14 border-b border-[var(--border-hairline)]">
    <div class="lg:col-span-7 min-w-0 space-y-6">
      <div class="inline-flex items-center gap-2 rounded-full border border-[var(--border-hairline)] bg-[var(--bg-surface)] px-3 py-1 text-xs text-[var(--text-secondary)]">
        <span class="h-1.5 w-1.5 rounded-full bg-[var(--signal-positive)]" />
        <span>Eco AI Lab, Hanbat National University · Daejeon, KR</span>
      </div>

      <div class="space-y-4">
        <h1 class="text-3xl sm:text-[42px] font-bold tracking-tight leading-[1.12] text-[var(--text-primary)]">
          Quantum control and sub-microsecond error correction.
        </h1>
        <p class="text-base sm:text-[17px] leading-relaxed text-[var(--text-secondary)] max-w-[60ch]">
          I am <strong class="font-semibold text-[var(--text-primary)]">Beomdo Park</strong>, a Computer Engineering
          researcher working at the intersection of reinforcement learning, open quantum systems, and hardware-aware
          neural decoders. I maintain{' '}
          <a href="/projects/qenvs" class="text-[var(--accent-primary)] hover:underline font-medium">QEnvS</a>{' '}
          and led the{' '}
          <a href="/projects/roqet" class="text-[var(--accent-primary)] hover:underline font-medium">ROQET</a>{' '}
          on-device QEC SoC project.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2.5 pt-1">
        <a
          href="/research"
          class="inline-flex items-center rounded-lg bg-[var(--text-primary)] px-4 py-2 text-sm font-medium text-[var(--bg-canvas)] hover:opacity-90 transition-opacity"
        >
          Explore research
        </a>
        <a
          href="/publications"
          class="inline-flex items-center rounded-lg border border-[var(--border-strong)] bg-[var(--bg-surface)] px-4 py-2 text-sm font-medium text-[var(--text-primary)] hover:bg-[var(--bg-subtle)] transition-colors"
        >
          Publications ({PUB_STATS.totalPapers})
        </a>
        <a
          href="/lab"
          class="inline-flex items-center rounded-lg border border-[var(--border-hairline)] bg-[var(--bg-surface)] px-4 py-2 text-sm font-medium text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:border-[var(--border-strong)] transition-colors"
        >
          Interactive Lab
        </a>
      </div>

      <!-- Verified stats strip -->
      <dl class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-4 border-t border-[var(--border-hairline)]">
        <div>
          <dt class="text-xs text-[var(--text-tertiary)]">Publications</dt>
          <dd class="mt-0.5 font-mono text-lg font-semibold tabular-nums text-[var(--text-primary)]">
            {PUB_STATS.totalPapers}
            <span class="text-xs font-normal text-[var(--text-tertiary)]"> ({PUB_STATS.firstAuthor} 1st)</span>
          </dd>
        </div>
        <div>
          <dt class="text-xs text-[var(--text-tertiary)]">Granted Patent</dt>
          <dd class="mt-0.5 font-mono text-lg font-semibold tabular-nums text-[var(--text-primary)]">
            {PUB_STATS.grantedPatents}
            <span class="text-xs font-normal text-[var(--text-tertiary)]"> KR</span>
          </dd>
        </div>
        <div>
          <dt class="text-xs text-[var(--text-tertiary)]">ROQET Latency</dt>
          <dd class="mt-0.5 font-mono text-lg font-semibold tabular-nums text-[var(--signal-positive)]">0.34 µs</dd>
        </div>
        <div>
          <dt class="text-xs text-[var(--text-tertiary)]">Open Source</dt>
          <dd class="mt-0.5 font-mono text-lg font-semibold text-[var(--accent-primary)]">QEnvS</dd>
        </div>
      </dl>

      <div class="flex flex-wrap items-center gap-x-4 gap-y-1.5 text-xs text-[var(--text-tertiary)]">
        <a href={SITE.links.github} target="_blank" rel="noreferrer" class="hover:text-[var(--text-primary)] transition-colors">GitHub</a>
        <a href={SITE.links.orcid} target="_blank" rel="noreferrer" class="hover:text-[var(--text-primary)] transition-colors">ORCID</a>
        <a href={SITE.links.scholar} target="_blank" rel="noreferrer" class="hover:text-[var(--text-primary)] transition-colors">Google Scholar</a>
        <a href={SITE.links.dbpia} target="_blank" rel="noreferrer" class="hover:text-[var(--text-primary)] transition-colors">DBpia</a>
        <a href={`mailto:${SITE.email}`} class="font-mono hover:text-[var(--text-primary)] transition-colors">{SITE.email}</a>
      </div>
    </div>

    <div class="lg:col-span-5 min-w-0">
      <HeroTelemetry client:load />
    </div>
  </section>

  <!-- Flagship Projects -->
  <section class="py-12 border-b border-[var(--border-hairline)] space-y-6">
    <div class="flex items-baseline justify-between gap-4">
      <div>
        <h2 class="text-xl font-semibold tracking-tight text-[var(--text-primary)]">Flagship engineering</h2>
        <p class="mt-1 text-sm text-[var(--text-secondary)]">
          Open-source quantum simulation infrastructure and hardware-verified QEC accelerators.
        </p>
      </div>
      <a href="/projects" class="text-sm font-medium text-[var(--accent-primary)] hover:underline shrink-0">
        All projects
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {
        featuredProjects.map((proj) => (
          <article class="flex flex-col justify-between rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-surface)] p-5 space-y-4">
            <div class="space-y-3">
              <div class="flex items-center justify-between gap-2">
                <a
                  href={`/projects/${proj.slug}`}
                  class="text-lg font-semibold text-[var(--text-primary)] hover:text-[var(--accent-primary)] transition-colors"
                >
                  {proj.name}
                </a>
                <span class="rounded border border-[var(--border-hairline)] bg-[var(--bg-subtle)] px-2 py-0.5 font-mono text-[11px] text-[var(--text-secondary)]">
                  {proj.period}
                </span>
              </div>
              <p class="text-sm leading-relaxed text-[var(--text-secondary)]">{proj.summary}</p>
            </div>

            <div class="space-y-3 pt-2 border-t border-[var(--border-hairline)]">
              <div class="grid grid-cols-2 gap-2.5 text-xs">
                {proj.metrics.slice(0, 2).map((m) => (
                  <div class="rounded-md bg-[var(--bg-subtle)]/65 px-2.5 py-2">
                    <div class="text-[11px] text-[var(--text-tertiary)]">{m.label}</div>
                    <div class="font-mono font-semibold text-[var(--text-primary)] mt-0.5">{m.value}</div>
                  </div>
                ))}
              </div>
              <div class="flex flex-wrap items-center justify-between gap-2 text-xs">
                <div class="flex flex-wrap gap-1.5">
                  {proj.stack.slice(0, 4).map((t) => (
                    <span class="font-mono text-[11px] text-[var(--text-tertiary)]">{t}</span>
                  ))}
                </div>
                <a href={`/projects/${proj.slug}`} class="font-medium text-[var(--accent-primary)] hover:underline">
                  Case study
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Research Tracks -->
  <section class="py-12 border-b border-[var(--border-hairline)] space-y-6">
    <div class="flex items-baseline justify-between gap-4">
      <div>
        <h2 class="text-xl font-semibold tracking-tight text-[var(--text-primary)]">Research areas</h2>
        <p class="mt-1 text-sm text-[var(--text-secondary)]">
          Three connected lines of work from physical dynamics to deployable algorithms and silicon.
        </p>
      </div>
      <a href="/research" class="text-sm font-medium text-[var(--accent-primary)] hover:underline shrink-0">
        Research details
      </a>
    </div>

    <div class="divide-y divide-[var(--border-hairline)] border-t border-b border-[var(--border-hairline)]">
      {
        RESEARCH_TRACKS.map((track) => (
          <div class="grid grid-cols-1 md:grid-cols-12 gap-4 py-5 items-start">
            <div class="md:col-span-4 space-y-1">
              <h3 class="text-base font-semibold text-[var(--text-primary)]">
                <a href={`/research#${track.id}`} class="hover:text-[var(--accent-primary)] transition-colors">
                  {track.title}
                </a>
              </h3>
              <p class="text-xs text-[var(--text-tertiary)]">{track.subtitle}</p>
            </div>
            <p class="md:col-span-5 text-sm leading-relaxed text-[var(--text-secondary)]">{track.summary}</p>
            <div class="md:col-span-3 flex flex-wrap md:flex-col gap-2 text-xs">
              {track.keyResults.slice(0, 2).map((r) => (
                <div class="rounded-md border border-[var(--border-hairline)] bg-[var(--bg-surface)] px-2.5 py-1.5">
                  <div class="font-mono font-semibold text-[var(--text-primary)]">{r.value}</div>
                  <div class="text-[11px] text-[var(--text-tertiary)]">{r.label}</div>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Selected Publications -->
  <section class="py-12 border-b border-[var(--border-hairline)] space-y-6">
    <div class="flex items-baseline justify-between gap-4">
      <div>
        <h2 class="text-xl font-semibold tracking-tight text-[var(--text-primary)]">Selected publications</h2>
        <p class="mt-1 text-sm text-[var(--text-secondary)]">
          {PUB_STATS.international} international and {PUB_STATS.domestic} domestic publications plus {PUB_STATS.grantedPatents} granted patent.
        </p>
      </div>
      <a href="/publications" class="text-sm font-medium text-[var(--accent-primary)] hover:underline shrink-0">
        Browse all &amp; BibTeX
      </a>
    </div>

    <ul class="divide-y divide-[var(--border-hairline)]">
      {
        featuredPubs.map((pub) => (
          <li class="py-3.5 flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
            <div class="space-y-1 max-w-[68ch]">
              <div class="flex flex-wrap items-center gap-1.5 text-xs">
                <span class="font-mono font-medium text-[var(--accent-primary)]">{pub.venueShort}</span>
                <span class="font-mono text-[var(--text-tertiary)]">{pub.year}</span>
                {pub.indexing && (
                  <span class="rounded border border-[var(--border-hairline)] bg-[var(--bg-subtle)] px-1.5 py-0.5 font-mono text-[10px] text-[var(--text-secondary)]">
                    {pub.indexing}
                  </span>
                )}
                {pub.isFirstAuthor && (
                  <span class="text-[11px] font-medium text-[var(--signal-positive)]">1st author</span>
                )}
              </div>
              <h3 class="text-sm font-medium leading-snug text-[var(--text-primary)]">
                {pub.url ? (
                  <a href={pub.url} target="_blank" rel="noreferrer" class="hover:text-[var(--accent-primary)] transition-colors">
                    {pub.title}
                  </a>
                ) : (
                  pub.title
                )}
              </h3>
              <p class="text-xs text-[var(--text-tertiary)]">{pub.authors}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Recent Technical Notes -->
  <section class="pt-12 space-y-6">
    <div class="flex items-baseline justify-between gap-4">
      <div>
        <h2 class="text-xl font-semibold tracking-tight text-[var(--text-primary)]">Recent technical notes</h2>
        <p class="mt-1 text-sm text-[var(--text-secondary)]">
          Implementation logs, QEC decoder experiments, and reproducible research workflows (Korean &amp; English).
        </p>
      </div>
      <a href="/blog" class="text-sm font-medium text-[var(--accent-primary)] hover:underline shrink-0">
        All {allPosts.length} posts
      </a>
    </div>

    <ul class="divide-y divide-[var(--border-hairline)]">
      {
        recentPosts.map((post) => (
          <li class="py-4">
            <a href={`/blog/${post.id}`} class="group grid grid-cols-1 sm:grid-cols-12 gap-2 sm:gap-4 items-baseline">
              <time
                datetime={post.data.pubDate.toISOString()}
                class="sm:col-span-2 font-mono text-xs tabular-nums text-[var(--text-tertiary)]"
              >
                {post.data.pubDate.toISOString().slice(0, 10)}
              </time>
              <div class="sm:col-span-10 space-y-1">
                <h3 class="text-[15px] font-medium text-[var(--text-primary)] group-hover:text-[var(--accent-primary)] transition-colors">
                  {post.data.title}
                </h3>
                {post.data.description && (
                  <p class="text-sm text-[var(--text-secondary)] line-clamp-2">{post.data.description}</p>
                )}
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
