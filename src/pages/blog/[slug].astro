---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );
  return posts.map((post, idx) => ({
    params: { slug: post.id },
    props: {
      post,
      prevPost: posts[idx + 1] ?? null,
      nextPost: posts[idx - 1] ?? null,
      seriesPosts: post.data.series
        ? posts
            .filter((p) => p.data.series === post.data.series)
            .sort((a, b) => (a.data.seriesOrder ?? 99) - (b.data.seriesOrder ?? 99))
        : [],
    },
  }));
}

const { post, prevPost, nextPost, seriesPosts } = Astro.props;
const { Content, headings } = await render(post);
const words = (post.body ?? '').split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(2, Math.round(words / 220));
const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

<BaseLayout
  locale="ko"
  title={post.data.title}
  description={post.data.description || post.data.title}
  ogType="article"
  pubDate={post.data.pubDate}
  includeKatex={true}
>
  <article>
    <header class="pb-7 border-b border-[var(--border-hairline)] space-y-3.5">
      <div class="flex flex-wrap items-center gap-2 text-xs font-mono text-[var(--text-tertiary)]">
        <a href="/blog" class="hover:text-[var(--text-primary)]">← 블로그 목록</a>
        <span>·</span>
        <time datetime={post.data.pubDate.toISOString()} class="tabular-nums">
          {post.data.pubDate.toISOString().slice(0, 10)}
        </time>
        <span>·</span>
        <span>약 {readingMinutes}분</span>
        {post.data.series && (
          <>
            <span>·</span>
            <a
              href={`/blog?series=${encodeURIComponent(post.data.series)}`}
              class="text-[var(--accent-primary)] hover:underline"
            >
              시리즈: {post.data.series}
              {post.data.seriesOrder ? ` #${post.data.seriesOrder}` : ''}
            </a>
          </>
        )}
      </div>

      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight leading-snug text-[var(--text-primary)]">
        {post.data.title}
      </h1>

      {post.data.description && (
        <p class="text-sm sm:text-base text-[var(--text-secondary)] leading-relaxed max-w-[68ch]">
          {post.data.description}
        </p>
      )}

      {post.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5 pt-0.5">
          {post.data.tags.map((tag) => (
            <span class="rounded border border-[var(--border-hairline)] bg-[var(--bg-subtle)] px-2 py-0.5 font-mono text-[11px] text-[var(--text-secondary)]">
              #{tag}
            </span>
          ))}
        </div>
      )}
    </header>

    {seriesPosts.length > 1 && (
      <details class="my-6 rounded-lg border border-[var(--border-hairline)] bg-[var(--bg-subtle)]/50 px-4 py-3 text-sm">
        <summary class="cursor-pointer font-medium text-[var(--text-primary)] select-none">
          시리즈 목록: {post.data.series} ({seriesPosts.length}편)
        </summary>
        <ol class="mt-3 space-y-1.5 border-t border-[var(--border-hairline)] pt-3 text-xs">
          {seriesPosts.map((sp, idx) => (
            <li class="flex items-baseline gap-2">
              <span class="font-mono text-[var(--text-tertiary)] w-5 shrink-0">{idx + 1}.</span>
              {sp.id === post.id ? (
                <span class="font-semibold text-[var(--accent-primary)]">{sp.data.title} (현재 글)</span>
              ) : (
                <a href={`/blog/${sp.id}`} class="text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:underline">
                  {sp.data.title}
                </a>
              )}
            </li>
          ))}
        </ol>
      </details>
    )}

    <div class="pt-8 grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      <div class="lg:col-span-9 min-w-0">
        <div class="prose prose-slate dark:prose-invert max-w-none">
          <Content />
        </div>
      </div>

      {tocHeadings.length > 0 && (
        <aside class="hidden lg:block lg:col-span-3 sticky top-20 space-y-2 border-l border-[var(--border-hairline)] pl-4 text-xs">
          <div class="font-semibold text-[var(--text-primary)]">목차</div>
          <nav aria-label="목차">
            <ul class="space-y-1.5">
              {tocHeadings.map((h) => (
                <li class={h.depth === 3 ? 'pl-3' : ''}>
                  <a
                    href={`#${h.slug}`}
                    class="block text-[var(--text-tertiary)] hover:text-[var(--text-primary)] transition-colors leading-snug"
                  >
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )}
    </div>

    <nav
      aria-label="이전 및 다음 글"
      class="mt-14 pt-6 border-t border-[var(--border-hairline)] grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm"
    >
      <div>
        {prevPost && (
          <a
            href={`/blog/${prevPost.id}`}
            class="block rounded-lg border border-[var(--border-hairline)] p-4 hover:border-[var(--border-strong)] transition-colors"
          >
            <div class="text-xs text-[var(--text-tertiary)]">이전 글</div>
            <div class="mt-1 font-medium text-[var(--text-primary)] line-clamp-2">{prevPost.data.title}</div>
          </a>
        )}
      </div>
      <div>
        {nextPost && (
          <a
            href={`/blog/${nextPost.id}`}
            class="block rounded-lg border border-[var(--border-hairline)] p-4 text-right hover:border-[var(--border-strong)] transition-colors"
          >
            <div class="text-xs text-[var(--text-tertiary)]">다음 글</div>
            <div class="mt-1 font-medium text-[var(--text-primary)] line-clamp-2">{nextPost.data.title}</div>
          </a>
        )}
      </div>
    </nav>
  </article>
</BaseLayout>
