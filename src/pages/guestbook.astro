---
import BaseLayout from '../layouts/BaseLayout.astro';
import Guestbook from '../components/react/Guestbook';
---

<BaseLayout
  title="Guestbook"
  description="Leave a note for Beomdo Park — powered by Cloudflare Workers and Cloudflare D1 SQLite at the edge."
>
  <header class="pb-8 border-b border-[var(--border-hairline)] space-y-3">
    <div class="flex flex-wrap items-center gap-2">
      <h1 class="text-3xl font-bold tracking-tight text-[var(--text-primary)]">Guestbook</h1>
      <span class="rounded border border-[var(--accent-primary)]/40 bg-[var(--accent-primary-soft)] px-2 py-0.5 font-mono text-xs text-[var(--accent-primary)]">
        Cloudflare Workers + D1
      </span>
    </div>
    <p class="text-base text-[var(--text-secondary)] max-w-[66ch]">
      Sign the logbook, ask about QEnvS or ROQET, or leave feedback on any technical post.
    </p>
  </header>

  <div class="pt-8">
    <Guestbook client:load />
  </div>
</BaseLayout>
