---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout locale="ko" title="페이지를 찾을 수 없습니다">
  <div class="py-16 space-y-5 max-w-lg">
    <p class="font-mono text-sm text-[var(--accent-primary)]">404</p>
    <h1 class="text-2xl font-bold tracking-tight text-[var(--text-primary)]">페이지를 찾을 수 없습니다</h1>
    <p class="text-sm text-[var(--text-secondary)] leading-relaxed">
      요청하신 주소가 존재하지 않거나 이동되었습니다. 상단 검색(Ctrl K)이나 홈·블로그 메뉴에서 찾으실 수 있습니다.
    </p>
    <div class="flex flex-wrap gap-2.5 pt-2 text-sm">
      <a href="/" class="rounded-lg bg-[var(--text-primary)] px-4 py-2 font-medium text-[var(--bg-canvas)]">
        홈으로
      </a>
      <a href="/blog" class="rounded-lg border border-[var(--border-strong)] px-4 py-2 font-medium text-[var(--text-primary)]">
        블로그
      </a>
      <a href="/en/" class="rounded-lg border border-[var(--border-hairline)] px-4 py-2 text-[var(--text-secondary)]">
        English Home
      </a>
    </div>
  </div>
</BaseLayout>
