---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PROFILE } from '../data/profile';
import { SITE } from '../data/site';
---

<BaseLayout title="About" description="Biography, education, research experience, awards, and technical stack of Beomdo Park.">
  <div class="space-y-12">
    <header class="pb-8 border-b border-[var(--border-hairline)] space-y-4">
      <h1 class="text-3xl font-bold tracking-tight text-[var(--text-primary)]">About</h1>
      <p class="text-base leading-relaxed text-[var(--text-secondary)] max-w-[68ch]">{PROFILE.summary}</p>
      <div class="flex flex-wrap items-center gap-3 text-xs font-mono">
        <a href={`mailto:${SITE.email}`} class="rounded-md border border-[var(--border-strong)] bg-[var(--bg-surface)] px-3 py-1.5 text-[var(--text-primary)] hover:bg-[var(--bg-subtle)]">
          {SITE.email}
        </a>
        <a href={SITE.links.github} target="_blank" rel="noreferrer" class="text-[var(--accent-primary)] hover:underline">GitHub</a>
        <a href={SITE.links.orcid} target="_blank" rel="noreferrer" class="text-[var(--accent-primary)] hover:underline">ORCID</a>
        <a href={SITE.links.scholar} target="_blank" rel="noreferrer" class="text-[var(--accent-primary)] hover:underline">Google Scholar</a>
        <a href={SITE.links.dbpia} target="_blank" rel="noreferrer" class="text-[var(--accent-primary)] hover:underline">DBpia</a>
        <a href={SITE.links.portfolioRepo} target="_blank" rel="noreferrer" class="text-[var(--accent-primary)] hover:underline">Portfolio Archive</a>
      </div>
    </header>

    <!-- Education -->
    <section class="space-y-4">
      <h2 class="text-lg font-semibold text-[var(--text-primary)]">Education</h2>
      {PROFILE.education.map((edu) => (
        <div class="rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-surface)] p-5 flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
          <div>
            <h3 class="text-base font-semibold text-[var(--text-primary)]">{edu.degree}</h3>
            <p class="text-sm text-[var(--text-secondary)]">{edu.institution}</p>
            <p class="mt-1 text-xs text-[var(--text-tertiary)]">{edu.detail}</p>
          </div>
          <span class="font-mono text-xs text-[var(--text-tertiary)] shrink-0">{edu.period}</span>
        </div>
      ))}
    </section>

    <!-- Experience -->
    <section class="space-y-4">
      <h2 class="text-lg font-semibold text-[var(--text-primary)]">Research &amp; Engineering Experience</h2>
      <ul class="divide-y divide-[var(--border-hairline)] border-t border-b border-[var(--border-hairline)]">
        {PROFILE.experiences.map((exp) => (
          <li class="py-4 grid grid-cols-1 sm:grid-cols-12 gap-2 sm:gap-4">
            <div class="sm:col-span-3 font-mono text-xs text-[var(--text-tertiary)]">{exp.period}</div>
            <div class="sm:col-span-9 space-y-1">
              <div class="text-sm font-semibold text-[var(--text-primary)]">{exp.role}</div>
              <div class="text-xs text-[var(--accent-primary)]">
                {exp.url ? (
                  <a href={exp.url} target="_blank" rel="noreferrer" class="hover:underline">{exp.org}</a>
                ) : (
                  exp.org
                )}
              </div>
              <p class="text-sm text-[var(--text-secondary)] leading-relaxed">{exp.detail}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <!-- Awards & Certifications -->
    <section class="space-y-4">
      <h2 class="text-lg font-semibold text-[var(--text-primary)]">Honors, Competitions &amp; Certifications</h2>
      <ul class="divide-y divide-[var(--border-hairline)] border-t border-b border-[var(--border-hairline)]">
        {PROFILE.awards.map((aw) => (
          <li class="py-3 grid grid-cols-1 sm:grid-cols-12 gap-1 sm:gap-4 items-baseline">
            <span class="sm:col-span-2 font-mono text-xs tabular-nums text-[var(--text-tertiary)]">{aw.date}</span>
            <div class="sm:col-span-10 space-y-0.5">
              <div class="text-sm font-medium text-[var(--text-primary)]">{aw.title}</div>
              <div class="text-xs text-[var(--text-secondary)]">
                {aw.org}{aw.detail ? ` — ${aw.detail}` : ''}
              </div>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <!-- Technical Stack -->
    <section class="space-y-4">
      <h2 class="text-lg font-semibold text-[var(--text-primary)]">Technical Stack</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {PROFILE.techStack.map((cat) => (
          <div class="rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-surface)] p-4 space-y-2.5">
            <h3 class="text-xs font-semibold text-[var(--text-tertiary)]">{cat.group}</h3>
            <div class="flex flex-wrap gap-1.5">
              {cat.items.map((item) => (
                <span class="rounded-md border border-[var(--border-hairline)] bg-[var(--bg-subtle)]/65 px-2.5 py-1 font-mono text-xs text-[var(--text-primary)]">
                  {item}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
