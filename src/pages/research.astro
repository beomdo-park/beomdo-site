---
import BaseLayout from '../layouts/BaseLayout.astro';
import { RESEARCH_TRACKS } from '../data/research';
import { PUBLICATIONS } from '../data/publications';

const pubMap = new Map(PUBLICATIONS.map((p) => [p.id, p]));
---

<BaseLayout
  title="Research"
  description="Research areas: Quantum Batteries & Open Quantum Control, Hardware-Aware Quantum Error Correction, and Scientific Machine Learning."
>
  <header class="pb-8 border-b border-[var(--border-hairline)] space-y-3">
    <h1 class="text-3xl font-bold tracking-tight text-[var(--text-primary)]">Research</h1>
    <p class="text-base text-[var(--text-secondary)] max-w-[66ch] leading-relaxed">
      My research centers on making quantum control and quantum error correction physically verifiable, robust under
      realistic noise, and fast enough to deploy on constrained hardware.
    </p>
  </header>

  <div class="divide-y divide-[var(--border-hairline)]">
    {
      RESEARCH_TRACKS.map((track) => {
        const pubs = track.relatedPubIds.map((id) => pubMap.get(id)).filter(Boolean);
        return (
          <section id={track.id} class="py-10 scroll-mt-20 space-y-6">
            <div class="space-y-2">
              <h2 class="text-2xl font-semibold tracking-tight text-[var(--text-primary)]">{track.title}</h2>
              <p class="text-sm text-[var(--accent-primary)] font-medium">{track.subtitle}</p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
              <div class="lg:col-span-7 space-y-4">
                <p class="text-sm sm:text-[15px] leading-relaxed text-[var(--text-secondary)]">{track.summary}</p>
                <div class="rounded-lg border border-[var(--border-hairline)] bg-[var(--bg-subtle)]/55 p-4">
                  <div class="text-xs font-medium text-[var(--text-tertiary)] mb-1">Core question</div>
                  <p class="text-sm text-[var(--text-primary)] leading-relaxed">{track.question}</p>
                </div>
                <div class="flex flex-wrap gap-1.5">
                  {track.methods.map((m) => (
                    <span class="rounded-md border border-[var(--border-hairline)] bg-[var(--bg-surface)] px-2.5 py-1 font-mono text-xs text-[var(--text-secondary)]">
                      {m}
                    </span>
                  ))}
                </div>
              </div>

              <div class="lg:col-span-5 space-y-3">
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-1 gap-2.5">
                  {track.keyResults.map((r) => (
                    <div class="rounded-lg border border-[var(--border-hairline)] bg-[var(--bg-surface)] p-3.5">
                      <div class="text-xs text-[var(--text-tertiary)]">{r.label}</div>
                      <div class="mt-0.5 font-mono text-base font-semibold text-[var(--text-primary)]">{r.value}</div>
                      {r.note && <div class="mt-0.5 text-xs text-[var(--text-secondary)]">{r.note}</div>}
                    </div>
                  ))}
                </div>

                <div class="flex flex-wrap gap-2 pt-1">
                  {track.relatedProjectSlug && (
                    <a
                      href={`/projects/${track.relatedProjectSlug}`}
                      class="rounded-md border border-[var(--border-strong)] bg-[var(--bg-surface)] px-3 py-1.5 text-xs font-medium text-[var(--text-primary)] hover:bg-[var(--bg-subtle)] transition-colors"
                    >
                      Project architecture
                    </a>
                  )}
                  {track.relatedLabTab && (
                    <a
                      href={`/lab#${track.relatedLabTab}`}
                      class="rounded-md bg-[var(--accent-primary-soft)] border border-[var(--accent-primary)]/40 px-3 py-1.5 text-xs font-medium text-[var(--accent-primary)] hover:opacity-90 transition-opacity"
                    >
                      Open interactive explorer
                    </a>
                  )}
                </div>
              </div>
            </div>

            {pubs.length > 0 && (
              <div class="space-y-2 pt-2">
                <h3 class="text-xs font-semibold text-[var(--text-tertiary)]">Representative papers &amp; patents</h3>
                <ul class="space-y-1.5 text-sm">
                  {pubs.map((p) => (
                    <li class="flex flex-wrap items-baseline gap-2">
                      <span class="font-mono text-xs text-[var(--accent-primary)] shrink-0">[{p!.venueShort} {p!.year}]</span>
                      <span class="text-[var(--text-primary)]">{p!.title}</span>
                      <span class="text-xs text-[var(--text-tertiary)]">({p!.role})</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </section>
        );
      })
    }
  </div>
</BaseLayout>
