---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PROJECTS, type ProjectItem } from '../../data/projects';
import QEnvSExplorer from '../../components/react/QEnvSExplorer';
import RoqetExplorer from '../../components/react/RoqetExplorer';

export function getStaticPaths() {
  return PROJECTS.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: ProjectItem;
}

const { project } = Astro.props;

const relatedPosts = project.relatedBlogPrefix
  ? (await getCollection('blog', ({ id, data }) => !data.draft && id.startsWith(project.relatedBlogPrefix!))).sort(
      (a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf()
    )
  : [];
---

<BaseLayout title={project.name} description={project.tagline}>
  <div class="space-y-10">
    <header class="pb-8 border-b border-[var(--border-hairline)] space-y-4">
      <a href="/projects" class="text-xs font-medium text-[var(--text-tertiary)] hover:text-[var(--text-primary)]">
        ← Back to projects
      </a>
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-[var(--text-primary)]">{project.name}</h1>
        <span class="font-mono text-xs text-[var(--text-tertiary)]">{project.period} · {project.status}</span>
      </div>
      <p class="text-base sm:text-lg text-[var(--text-secondary)] max-w-[66ch]">{project.tagline}</p>

      {project.links.length > 0 && (
        <div class="flex flex-wrap gap-2 pt-1">
          {project.links.map((l) => (
            <a
              href={l.href}
              target={l.href.startsWith('http') ? '_blank' : undefined}
              rel={l.href.startsWith('http') ? 'noreferrer' : undefined}
              class="rounded-lg border border-[var(--border-strong)] bg-[var(--bg-surface)] px-3 py-1.5 text-xs font-medium text-[var(--text-primary)] hover:bg-[var(--bg-subtle)] transition-colors"
            >
              {l.label}
            </a>
          ))}
        </div>
      )}
    </header>

    <!-- Verified Metrics -->
    <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5">
      {project.metrics.map((m) => (
        <div class="rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-surface)] p-4">
          <div class="text-xs text-[var(--text-tertiary)]">{m.label}</div>
          <div class="mt-1 font-mono text-xl font-semibold text-[var(--text-primary)]">{m.value}</div>
          {m.context && <div class="mt-1 text-xs text-[var(--text-secondary)]">{m.context}</div>}
        </div>
      ))}
    </section>

    <!-- Problem & Architecture -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <div class="lg:col-span-5 space-y-3">
        <h2 class="text-lg font-semibold text-[var(--text-primary)]">Problem statement</h2>
        <p class="text-sm leading-relaxed text-[var(--text-secondary)]">{project.problem}</p>
        <p class="text-sm leading-relaxed text-[var(--text-secondary)]">{project.summary}</p>
      </div>
      <div class="lg:col-span-7 space-y-3">
        <h2 class="text-lg font-semibold text-[var(--text-primary)]">System architecture &amp; engineering decisions</h2>
        <ul class="space-y-2.5">
          {project.architecture.map((point) => (
            <li class="rounded-lg border border-[var(--border-hairline)] bg-[var(--bg-surface)] px-4 py-3 text-sm leading-relaxed text-[var(--text-secondary)]">
              {point}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Embedded Interactive Explorer -->
    {project.labTab === 'qenvs' && (
      <section class="space-y-3">
        <h2 class="text-lg font-semibold text-[var(--text-primary)]">Live physics explorer</h2>
        <QEnvSExplorer client:visible />
      </section>
    )}
    {project.labTab === 'roqet' && (
      <section class="space-y-3">
        <h2 class="text-lg font-semibold text-[var(--text-primary)]">Interactive experiment telemetry</h2>
        <RoqetExplorer client:visible />
      </section>
    )}

    <!-- Related Technical Notes -->
    {relatedPosts.length > 0 && (
      <section class="space-y-4 pt-4 border-t border-[var(--border-hairline)]">
        <h2 class="text-lg font-semibold text-[var(--text-primary)]">Related engineering log ({relatedPosts.length} posts)</h2>
        <ul class="divide-y divide-[var(--border-hairline)]">
          {relatedPosts.map((post) => (
            <li class="py-3">
              <a href={`/blog/${post.id}`} class="group flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-4">
                <time class="font-mono text-xs text-[var(--text-tertiary)] shrink-0">
                  {post.data.pubDate.toISOString().slice(0, 10)}
                </time>
                <span class="text-sm font-medium text-[var(--text-primary)] group-hover:text-[var(--accent-primary)] transition-colors">
                  {post.data.title}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</BaseLayout>
