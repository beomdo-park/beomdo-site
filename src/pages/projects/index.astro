---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PROJECTS } from '../../data/projects';
---

<BaseLayout
  title="Projects"
  description="Open-source software and hardware engineering projects: QEnvS, ROQET QEC Decoder SoC, Kaggle VQCC, and Industrial Power Anomaly Detection."
>
  <header class="pb-8 border-b border-[var(--border-hairline)] space-y-3">
    <h1 class="text-3xl font-bold tracking-tight text-[var(--text-primary)]">Projects</h1>
    <p class="text-base text-[var(--text-secondary)] max-w-[66ch] leading-relaxed">
      Systems I designed, implemented, and verified—from JAX quantum simulation libraries to bit-exact INT8 RTL accelerators.
    </p>
  </header>

  <div class="pt-8 space-y-6">
    {
      PROJECTS.map((proj) => (
        <article class="rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-surface)] p-6 space-y-5">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <div>
              <h2 class="text-xl font-semibold text-[var(--text-primary)]">
                <a href={`/projects/${proj.slug}`} class="hover:text-[var(--accent-primary)] transition-colors">
                  {proj.name}
                </a>
              </h2>
              <p class="mt-0.5 text-sm text-[var(--text-secondary)]">{proj.tagline}</p>
            </div>
            <div class="flex items-center gap-2 text-xs font-mono">
              <span class="rounded border border-[var(--border-hairline)] bg-[var(--bg-subtle)] px-2 py-0.5 text-[var(--text-secondary)]">
                {proj.status}
              </span>
              <span class="text-[var(--text-tertiary)]">{proj.period}</span>
            </div>
          </div>

          <p class="text-sm leading-relaxed text-[var(--text-secondary)] max-w-[76ch]">{proj.summary}</p>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
            {proj.metrics.map((m) => (
              <div class="rounded-lg border border-[var(--border-hairline)] bg-[var(--bg-subtle)]/50 p-3">
                <div class="text-[11px] text-[var(--text-tertiary)]">{m.label}</div>
                <div class="mt-0.5 font-mono text-sm font-semibold text-[var(--text-primary)]">{m.value}</div>
                {m.context && <div class="mt-0.5 text-[11px] text-[var(--text-secondary)] line-clamp-2">{m.context}</div>}
              </div>
            ))}
          </div>

          <div class="flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-[var(--border-hairline)]">
            <div class="flex flex-wrap gap-1.5">
              {proj.stack.map((t) => (
                <span class="rounded border border-[var(--border-hairline)] bg-[var(--bg-subtle)]/50 px-2 py-0.5 font-mono text-[11px] text-[var(--text-secondary)]">
                  {t}
                </span>
              ))}
            </div>
            <div class="flex flex-wrap items-center gap-3 text-xs font-medium">
              {proj.labTab && (
                <a href={`/lab#${proj.labTab}`} class="text-[var(--signal-positive)] hover:underline">
                  Interactive Explorer
                </a>
              )}
              <a href={`/projects/${proj.slug}`} class="text-[var(--accent-primary)] hover:underline">
                Read full case study
              </a>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</BaseLayout>
