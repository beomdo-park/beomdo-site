---
import '../styles/global.css';
import { SITE } from '../data/site';
import { NAV_LABELS, UI_STRINGS, getLocalePath, switchLocalePath, type Locale } from '../data/i18n';
import ThemeToggle from '../components/react/ThemeToggle';
import SearchModal from '../components/react/SearchModal';

interface Props {
  locale?: Locale;
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  pubDate?: Date;
  canonicalPath?: string;
  includeKatex?: boolean;
}

const {
  locale = 'ko',
  title,
  description,
  ogType = 'website',
  pubDate,
  canonicalPath,
  includeKatex = false,
} = Astro.props;

const t = UI_STRINGS[locale];
const navItems = NAV_LABELS[locale];
const siteTitle = SITE.title[locale];
const pageTitle = !title || title === siteTitle ? siteTitle : `${title} — ${t.brandName}`;
const pageDesc = description ?? SITE.description[locale];

const currentPath = Astro.url.pathname;
const koHref = switchLocalePath(currentPath, 'ko');
const enHref = switchLocalePath(currentPath, 'en');

const siteOrigin = Astro.site?.toString() ?? 'https://beomdo-site.pbeomdo.workers.dev';
const canonicalUrl = new URL(canonicalPath ?? currentPath, siteOrigin).toString();
const koAlternate = new URL(koHref, siteOrigin).toString();
const enAlternate = new URL(enHref, siteOrigin).toString();

const jsonLd =
  ogType === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description: pageDesc,
        author: { '@type': 'Person', name: SITE.author, url: siteOrigin },
        datePublished: pubDate?.toISOString(),
        url: canonicalUrl,
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: SITE.author,
        alternateName: SITE.authorKo,
        jobTitle: 'Quantum AI & Scientific Machine Learning Researcher',
        affiliation: { '@type': 'Organization', name: SITE.affiliation.en },
        url: siteOrigin,
        sameAs: [SITE.links.github, SITE.links.orcid, SITE.links.scholar, SITE.links.dbpia],
      };
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content={SITE.verification.google} />
    <meta name="naver-site-verification" content={SITE.verification.naver} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="ko" href={koAlternate} />
    <link rel="alternate" hreflang="en" href={enAlternate} />
    <link rel="alternate" hreflang="x-default" href={koAlternate} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name.ko} RSS`} href="/rss.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={locale === 'ko' ? 'ko_KR' : 'en_US'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={SITE.name[locale]} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />

    <!-- Fonts: Pretendard Variable + Instrument Sans + JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    {
      includeKatex && (
        <link
          rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/katex@0.16.22/dist/katex.min.css"
          crossorigin="anonymous"
        />
      )
    }

    <!-- Clean Light Default (switches to dark if user chose dark) -->
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('theme');
        if (stored === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body class="flex flex-col min-h-dvh selection:bg-[var(--accent-primary-soft)] selection:text-[var(--accent-primary)]">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:bg-[var(--bg-surface)] focus:px-3 focus:py-2 focus:text-sm focus:border focus:border-[var(--accent-primary)]"
    >
      {t.skipToContent}
    </a>

    <!-- Minimal Academic Header -->
    <header class="sticky top-0 z-40 border-b border-[var(--border-hairline)] bg-[var(--bg-canvas)]/92 backdrop-blur-md">
      <div class="mx-auto flex h-14 max-w-4xl items-center justify-between px-4 sm:px-6 gap-3">
        <a
          href={getLocalePath(locale, '/')}
          class="flex items-baseline gap-2 text-[15px] font-semibold tracking-tight text-[var(--text-primary)] hover:text-[var(--accent-primary)] transition-colors shrink-0"
        >
          <span>{t.brandName}</span>
          <span class="hidden sm:inline text-xs font-normal text-[var(--text-tertiary)]">{t.brandSub}</span>
        </a>

        <nav aria-label="Primary navigation" class="hidden md:flex items-center gap-1">
          {
            navItems.map((item) => {
              const isHome = item.href === '/' || item.href === '/en/';
              const active = isHome
                ? currentPath === item.href || (item.href === '/en/' && currentPath === '/en')
                : currentPath === item.href || currentPath.startsWith(`${item.href}/`);
              return (
                <a
                  href={item.href}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    'rounded-md px-2.5 py-1.5 text-sm transition-colors',
                    active
                      ? 'font-semibold text-[var(--text-primary)] bg-[var(--bg-subtle)]'
                      : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)]',
                  ]}
                >
                  {item.label}
                </a>
              );
            })
          }
        </nav>

        <div class="flex items-center gap-1.5 shrink-0">
          <!-- Prominent KO | EN Switcher -->
          <div
            role="group"
            aria-label="Language switcher"
            class="inline-flex h-8 items-center rounded-md border border-[var(--border-hairline)] bg-[var(--bg-subtle)] p-0.5 font-mono text-[11px]"
          >
            <a
              href={koHref}
              hreflang="ko"
              aria-current={locale === 'ko' ? 'true' : undefined}
              class:list={[
                'rounded px-1.5 py-1 leading-none transition-colors',
                locale === 'ko'
                  ? 'bg-[var(--bg-surface)] font-semibold text-[var(--text-primary)] shadow-2xs'
                  : 'text-[var(--text-tertiary)] hover:text-[var(--text-primary)]',
              ]}
            >
              KO
            </a>
            <a
              href={enHref}
              hreflang="en"
              aria-current={locale === 'en' ? 'true' : undefined}
              class:list={[
                'rounded px-1.5 py-1 leading-none transition-colors',
                locale === 'en'
                  ? 'bg-[var(--bg-surface)] font-semibold text-[var(--text-primary)] shadow-2xs'
                  : 'text-[var(--text-tertiary)] hover:text-[var(--text-primary)]',
              ]}
            >
              EN
            </a>
          </div>

          <SearchModal client:load locale={locale} />
          <ThemeToggle client:load />

          <button
            id="mobile-menu-btn"
            type="button"
            aria-label="Toggle navigation menu"
            aria-expanded="false"
            class="md:hidden inline-flex h-8 w-8 items-center justify-center rounded-md border border-[var(--border-hairline)] bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:text-[var(--text-primary)]"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="4" y1="7" x2="20" y2="7" />
              <line x1="4" y1="12" x2="20" y2="12" />
              <line x1="4" y1="17" x2="20" y2="17" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Drawer -->
      <nav
        id="mobile-menu"
        aria-label="Mobile navigation"
        class="hidden md:hidden border-t border-[var(--border-hairline)] bg-[var(--bg-canvas)] px-4 py-3"
      >
        <div class="flex flex-wrap gap-1.5">
          {
            navItems.map((item) => {
              const isHome = item.href === '/' || item.href === '/en/';
              const active = isHome
                ? currentPath === item.href
                : currentPath === item.href || currentPath.startsWith(`${item.href}/`);
              return (
                <a
                  href={item.href}
                  class:list={[
                    'rounded-md px-3 py-1.5 text-sm',
                    active
                      ? 'bg-[var(--bg-subtle)] font-semibold text-[var(--text-primary)]'
                      : 'text-[var(--text-secondary)] hover:bg-[var(--bg-subtle)]/60',
                  ]}
                >
                  {item.label}
                </a>
              );
            })
          }
        </div>
      </nav>
    </header>

    <main id="main-content" data-pagefind-body class="flex-1 mx-auto w-full max-w-4xl px-4 sm:px-6 py-10 sm:py-14">
      <slot />
    </main>

    <!-- Quiet Academic Footer -->
    <footer class="border-t border-[var(--border-hairline)]">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 py-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-xs text-[var(--text-tertiary)]">
        <div class="space-y-1">
          <p class="text-[var(--text-secondary)] font-medium">
            © {new Date().getFullYear()} {SITE.name[locale]}
          </p>
          <p>{t.footerNote}</p>
        </div>
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
          <a href={getLocalePath(locale, '/guestbook')} class="hover:text-[var(--text-primary)] transition-colors">{t.guestbook}</a>
          <a href={SITE.links.github} target="_blank" rel="noreferrer" class="hover:text-[var(--text-primary)] transition-colors">GitHub</a>
          <a href={SITE.links.scholar} target="_blank" rel="noreferrer" class="hover:text-[var(--text-primary)] transition-colors">Scholar</a>
          <a href={SITE.links.dbpia} target="_blank" rel="noreferrer" class="hover:text-[var(--text-primary)] transition-colors">DBpia</a>
          <a href={SITE.links.orcid} target="_blank" rel="noreferrer" class="hover:text-[var(--text-primary)] transition-colors">ORCID</a>
          <a href="/rss.xml" class="hover:text-[var(--text-primary)] transition-colors">RSS</a>
        </div>
      </div>
    </footer>

    <script is:inline>
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      btn?.addEventListener('click', () => {
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!expanded));
        menu?.classList.toggle('hidden');
      });
    </script>
  </body>
</html>
