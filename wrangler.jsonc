{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beomdo-site",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "beomdo-site-db",
      "database_id": "e6ea927b-2bc2-4c09-9ef7-38c858b2aafb"
    }
  ]
}
