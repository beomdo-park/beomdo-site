{
  "name": "beomdo-site",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && npx pagefind --site dist",
    "preview": "wrangler dev",
    "deploy": "pnpm check && pnpm build && wrangler deploy",
    "ship": "pnpm deploy && git push",
    "check": "astro check",
    "new:post": "node scripts/new-post.mjs",
    "qmd:publish": "python3 scripts/publish-qmd.py",
    "publish:post": "node scripts/publish-post.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.0",
    "@astrojs/mdx": "^4.3.0",
    "@astrojs/react": "^4.3.0",
    "@astrojs/rss": "^4.0.12",
    "@astrojs/sitemap": "^3.4.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.0",
    "astro": "^5.13.0",
    "js-yaml": "^4.1.0",
    "katex": "^0.16.22",
    "lucide-react": "^0.540.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@cloudflare/workers-types": "^4.20250801.0",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "pagefind": "^1.3.0",
    "typescript": "^5.8.0",
    "wrangler": "^4.30.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
